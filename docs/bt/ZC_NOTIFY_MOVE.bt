#include "inc/common.bt"
#include "inc/versions.bt"

ClientHeaderFixed header;

int handle;

// The coordinate format changed in Beta2? (Hypothetical example)
if (CLIENT_VERSION < BETA2) {
    short x;
    short y;
} else {
    // Packed coordinates (3 bytes) used in later versions
    ubyte p1;
    ubyte p2;
    ubyte p3;
    
    local int x = (p1 << 2) | (p2 >> 6);
    local int y = ((p2 & 0x3F) << 4) | (p3 >> 4);
    Printf("Coords: %d, %d\n", x, y);
}

int tick;