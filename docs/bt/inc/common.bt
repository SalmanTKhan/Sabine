#include "inc/headers.bt"
#include "inc/enums.bt"
#include "inc/params.bt"
#include "inc/versions.bt"
#include "inc/structs.bt"

Printf("Game Version: %d\n", CLIENT_VERSION);

typedef unsigned int IP4 < read=IP4ToString >;

string IP4ToString(IP4 &ip)
{
    // Little-endian storage (common). For 127.0.0.1 this is 0x0100007F
    return Str("%d.%d.%d.%d",
        ip & 0xFF,
        (ip >> 8) & 0xFF,
        (ip >> 16) & 0xFF,
        (ip >> 24) & 0xFF);
}

typedef struct {
    ubyte b1;
    ubyte b2;
    ubyte b3;
    
    // Calculated coordinates for display
    local int x = (b1 << 2) | (b2 >> 6);
    local int y = ((b2 & 0x3F) << 4) | (b3 >> 4);
    local int dir = (b3 & 0x0F);
} PackedCoordinate <read=Str("(%d, %d) Dir: %d", x, y, dir)>;